{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cursor-hackathon.local/schemas/journal/calendar-response.json",
  "title": "CalendarResponse",
  "type": "object",
  "required": ["days"],
  "properties": {
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "entry_ids", "count"],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Calendar day in user timezone from settings, or UTC when unset"
          },
          "entry_ids": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Journal entry ObjectIds as strings for that day"
          },
          "count": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
