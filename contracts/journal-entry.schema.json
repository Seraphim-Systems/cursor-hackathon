{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cursor-hackathon.local/schemas/journal/journal-entry.json",
  "title": "JournalEntry",
  "type": "object",
  "required": ["id", "user_id", "source", "created_at", "updated_at"],
  "properties": {
    "id": { "type": "string" },
    "user_id": { "type": "string" },
    "source": { "type": "string", "enum": ["text", "audio", "mixed"] },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "audio_storage_key": { "type": ["string", "null"] },
    "transcript": { "type": ["string", "null"] },
    "cleaned_text": { "type": ["string", "null"] },
    "summary": { "type": ["string", "null"] },
    "sentiment_score": { "type": ["number", "null"], "minimum": -1, "maximum": 1 },
    "insights": { "$ref": "./insights.schema.json" },
    "insights_field_locks": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Keys or dot-paths excluded from AI overwrite on re-analyze"
    }
  },
  "additionalProperties": true
}
