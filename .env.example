# =============================================================================
# Local & deployment configuration (copy to `.env`; never commit `.env`)
# =============================================================================
# Docker Compose reads this file automatically from the repo root for variable
# substitution. In CI/CD, define the same keys as encrypted secrets and export
# or write `.env` only on the runner right before `docker compose` / deploy.
# See docs/DEPLOYMENT.md.

# -----------------------------------------------------------------------------
# MongoDB
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB_NAME=journal

# -----------------------------------------------------------------------------
# Auth (use a long random value in production; rotate if leaked)
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-generate-long-random-string-for-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# -----------------------------------------------------------------------------
# API (Python app service)
# -----------------------------------------------------------------------------
AUDIO_STORAGE_PATH=/data/audio
# Comma-separated origins allowed by CORS (browser clients)
CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost

# -----------------------------------------------------------------------------
# Optional adapters (empty = stub implementations)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=

# Transcription: stub | openai | http_stt (Compose default when unset is http_stt)
# Note: http_stt uses the internal 'stt' service defined in docker-compose.yml
TRANSCRIPTION_PROVIDER=http_stt

# HTTP STT (used when TRANSCRIPTION_PROVIDER=http_stt; hostname is the Compose service)
STT_BASE_URL=http://stt:9000
STT_TRANSCRIBE_PATH=/asr
STT_FORM_FIELD=audio_file
STT_TIMEOUT_SECONDS=600

# OpenAI Transcription (used when TRANSCRIPTION_PROVIDER=openai)
TRANSCRIPTION_OPENAI_MODEL=whisper-1

# AI analysis: stub | openai (OpenAI-compatible Chat Completions HTTP API)
AI_ANALYSIS_PROVIDER=stub
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_MODEL=gpt-4o-mini
AI_HTTP_TIMEOUT_SECONDS=120

# -----------------------------------------------------------------------------
# Web build (Vite — baked at `web` image build time for production)
# -----------------------------------------------------------------------------
# URL the browser uses to call the API (host machine when using published ports)
VITE_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Docker Compose volumes (named volumes; see docker-compose.yml)
# -----------------------------------------------------------------------------
# - mongo_data  → mongo:/data/db
# - audio_uploads → app:/data/audio (journal audio files)
# - whisper_cache → stt:/root/.cache (ASR model cache; optional STT service)

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=adminpassword
